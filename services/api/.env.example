DJANGO_SECRET_KEY=replace-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# Runtime services use the separate least-privilege URL. Migrations must force
# DUKAAN_USE_APP_DB_ROLE=false so they keep using the operator DATABASE_URL.
DUKAAN_USE_APP_DB_ROLE=true
DUKAAN_APP_DATABASE_URL=postgresql://dukaan_app:strong-random-password@host:5432/postgres?sslmode=require
DUKAAN_APP_DB_ROLE=dukaan_app
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Optional per-user (authenticated) or per-IP (anonymous) DRF limits.
DUKAAN_THROTTLE_AUTH_RATE=10/min
DUKAAN_THROTTLE_ASSISTANT_RATE=30/min
DUKAAN_THROTTLE_UPLOADS_RATE=10/min
DUKAAN_THROTTLE_WRITE_RATE=60/min
DUKAAN_THROTTLE_READ_RATE=120/min
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8080
DEV_AUTH_ENABLED=false
# Verification codes. Configure MSG91 and keep dev-code exposure disabled in
# production. The template variable must match the approved DLT template.
SMS_ENABLED=false
OTP_EXPOSE_DEV_CODE=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=OTP
MSG91_API_BASE=https://control.msg91.com/api/v5
SMS_TIMEOUT_SECONDS=15

# Private storage and optional Gmail receipts integration.
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=business-documents
OCR_ENABLED=true
OCR_API_URL=https://ocr.example.com
OCR_API_TOKEN=REQUIRED_SERVER_ONLY_SECRET_WHEN_PROTECTED
OCR_PROVIDER=ocria
OCR_LANGUAGES=eng+hin
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_POLL_TIMEOUT_SECONDS=300
OCR_POLL_INTERVAL_SECONDS=1
OCR_MAX_RESULT_BYTES=2097152
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
ATTACHMENT_QUARANTINE_REQUIRED=false
ATTACHMENT_QUARANTINE_RETENTION_DAYS=7
ATTACHMENT_RETENTION_DAYS=30
# Dotted scanner implementation path, for example package.module.ScannerClass.
ATTACHMENT_SCANNER=
GMAIL_ENABLED=false
GMAIL_AI_EXTRACTION=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://api.example.com/api/v1/integrations/gmail/callback/
GMAIL_WEB_REDIRECT_URL=https://app.example.com/settings
GMAIL_TOKEN_ENCRYPTION_KEY=

# Production transcription uses an OpenAI-compatible endpoint. No model
# weights are downloaded by the application.
STT_PROVIDER=whisper
STT_MODEL=whisper-1
STT_API_BASE=
STT_API_KEY=
STT_TIMEOUT_SECONDS=60
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_USE_X_FORWARDED_HOST=true

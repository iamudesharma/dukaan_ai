openapi: 3.0.3
info:
  title: DukaanAI API
  version: 1.0.0
  description: Tenant-safe operational API for DukaanAI
paths:
  /api/v1/assistant/attachments/presign/:
    post:
      operationId: api_v1_assistant_attachments_presign_create
      description: |-
        Mint a short-lived upload ticket for one voice/image file.

        Bytes go straight from the device to private object storage; the
        server only records identity and tenancy up front. Transcription
        (Phase 1) verifies the object server-side before trusting it.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Attachment'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Attachment'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Attachment'
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Attachment'
          description: ''
  /api/v1/assistant/attachments/upload/:
    post:
      operationId: api_v1_assistant_attachments_upload_create
      description: |-
        Upload a small voice file through Django for local/private storage.

        Production clients can still use direct presigned uploads. This route
        makes the project-local storage backend usable without a second public
        file server.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Attachment'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Attachment'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Attachment'
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Attachment'
          description: ''
  /api/v1/assistant/proposals/:
    get:
      operationId: api_v1_assistant_proposals_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - api
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAssistantProposalList'
          description: ''
    post:
      operationId: api_v1_assistant_proposals_create
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
      security:
      - bearerAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/assistant/proposals/{id}/:
    get:
      operationId: api_v1_assistant_proposals_retrieve

        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/assistant/proposals/{id}/revise/:
    post:
      operationId: api_v1_assistant_proposals_revise_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/assistant/proposals/{id}/revisions/:
    get:
      operationId: api_v1_assistant_proposals_revisions_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - api
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/assistant/proposals/from-audio/:
    post:
      operationId: api_v1_assistant_proposals_from_audio_create
      description: |-
        Create a voice proposal from an uploaded attachment and queue
        transcription. Returns immediately (201 for a new proposal, 200 for
        a reused open one); the client polls until the transcript lands.

        Client retries are safe: re-POSTing the same attachment returns the
        still-open proposal instead of minting duplicates, and the worker
        ignores redelivery after a transcript is stored.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/assistant/proposals/from-image/:
    post:
      operationId: api_v1_assistant_proposals_from_image_create
      description: |-
        Create/reuse an IMAGE proposal and queue local OCR.

        The attachment must be the caller's own JPEG, PNG, or PDF upload in
        the selected business. Location access and business/location linkage
        are checked before anything is queued. Retrying with the same open
        attachment reuses its proposal; the worker safely ignores redelivery
        once recognized text has been applied.
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AssistantProposal'
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssistantProposal'
          description: ''
  /api/v1/audit-events/:
    get:
      operationId: api_v1_audit_events_list

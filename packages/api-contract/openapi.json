components:
  schemas:
    AssistantProposal:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        business:
          type: string
          format: uuid
          readOnly: true
        location:
          type: string
          format: uuid
          readOnly: true
        input_type:
          enum:
          - TEXT
          - VOICE
          - IMAGE
          type: string
          description: |-
            * `TEXT` - Text
            * `VOICE` - Voice transcript
            * `IMAGE` - Image OCR text
          x-spec-enum-id: 18ec21e9b1d10694
          readOnly: true
        locale:
          type: string
          readOnly: true
        content:
          type: string
          readOnly: true
        command_type:
          type: string
          readOnly: true
        payload:
          readOnly: true
        preview:
          type: string
          readOnly: true
        warnings:
          readOnly: true
        blocking_questions:
          readOnly: true
        status:
          enum:
          - DRAFT
          - READY
          - CONFIRMED
          - CANCELLED
          - EXPIRED
          type: string
          description: |-
            * `DRAFT` - Needs clarification
            * `READY` - Ready to confirm
            * `CONFIRMED` - Confirmed
            * `CANCELLED` - Cancelled
            * `EXPIRED` - Expired
          x-spec-enum-id: 3265216cef337572
          readOnly: true
        version:
          type: integer
          readOnly: true

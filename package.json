{
  "name": "dukaanai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @dukaanai/web",
    "build:web": "npm run build --workspace @dukaanai/web",
    "test:web": "npm run test --workspace @dukaanai/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:web": "npm run lint --workspace @dukaanai/web",
    "schema:generate": "node packages/api-contract/scripts/sync.mjs",
    "schema:check": "node packages/api-contract/scripts/sync.mjs --check",
    "clients:generate": "npm run generate --workspace @dukaanai/api-contract && npm run generate:dart --workspace @dukaanai/api-contract",
    "clients:check": "npm run schema:check && npm run check --workspace @dukaanai/api-contract",
    "clients:dart:check": "npm run check:dart --workspace @dukaanai/api-contract",
    "tokens:build": "node packages/design-tokens/scripts/build.mjs",
    "tokens:check": "node packages/design-tokens/scripts/build.mjs --check"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.43.0",
    "@playwright/test": "1.65.1"
  }
}

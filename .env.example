# DukaanAI local development defaults. Copy to .env and keep that file private.
# These credentials are intentionally local-only and match compose.yaml.
DJANGO_SECRET_KEY=unsafe-local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_HOST=false
DATABASE_URL=postgresql://dukaan:dukaan_local_only@localhost:5433/dukaan
# Migrations/operator commands use DATABASE_URL. Set the runtime flag true for
# runserver/worker/scheduler; force it false for migrate and other DDL commands.
DUKAAN_USE_APP_DB_ROLE=false
DUKAAN_APP_DATABASE_URL=postgresql://dukaan_app:dukaan_app_local_only@localhost:5433/dukaan
# Local least-privilege role for the API/worker and raw-SQL RLS tests.
DUKAAN_APP_DB_ROLE=dukaan_app
DUKAAN_APP_DB_PASSWORD=dukaan_app_local_only
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=false
DEV_AUTH_ENABLED=true
# The Vite dev server binds 127.0.0.1 and serves on port 4173, so its origin is
# http://127.0.0.1:4173 — "localhost" is a different origin for CORS purposes.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://localhost:5173

# Verification codes. No SMS provider is wired yet, so local development runs
# with OTP_EXPOSE_DEV_CODE=true, which returns the code in the API response.
# Both must stay false in production.
SMS_ENABLED=false
OTP_EXPOSE_DEV_CODE=true
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Must exactly match the variable name in your approved MSG91 DLT template.
MSG91_OTP_VARIABLE=OTP
MSG91_API_BASE=https://control.msg91.com/api/v5
SMS_TIMEOUT_SECONDS=15

# AI extraction adapter (server-only; never expose keys to mobile/web builds).
# See docs/runbooks/ai-provider.md. Verify any change with:
#   cd services/api && uv run --locked python manage.py check_ai --call
# Set to true to enable model-based interpretation; false keeps deterministic parsing.
USE_AI_INTERPRETER=false
# fake (abstain to deterministic) | openai_compatible | chatgpt (legacy)
AI_PROVIDER=fake
AI_MODEL=gpt-4o-mini
# Provider root WITHOUT /chat/completions. openai_compatible works with hosted
# gateways (https://api.openai.com/v1) and local servers (http://localhost:11434/v1).
# Local servers need no key: leave AI_API_KEY empty and no Authorization is sent.
AI_API_BASE=
AI_API_KEY=
AI_TIMEOUT_SECONDS=20
# Legacy unofficial-ChatGPT path (AI_PROVIDER=chatgpt only).
CHATGPT_SESSION_TOKEN=
CHATGPT_SESSION_TIMEOUT=3600

# Private object storage for voice/image uploads (server-only).
# local keeps files under this project for development; supabase uses private
# Storage with server-only credentials. Never expose keys to mobile/web builds.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local_storage
ATTACHMENT_MAX_BYTES=8388608
SIGNED_URL_TTL_SECONDS=900
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=business-documents

# OCR uses the Rust doc-extractor API and its provisioned OCRia-nano model.
# No OCR packages or model downloads are used by DukaanAI.
OCR_ENABLED=true
OCR_API_URL=http://127.0.0.1:8790
OCR_API_TOKEN=
OCR_PROVIDER=ocria
OCR_LANGUAGES=eng+hin
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_POLL_TIMEOUT_SECONDS=300
OCR_POLL_INTERVAL_SECONDS=1
OCR_MAX_RESULT_BYTES=2097152

# Push notifications, reminders, and attachment retention.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
ATTACHMENT_QUARANTINE_REQUIRED=false
ATTACHMENT_QUARANTINE_RETENTION_DAYS=7
ATTACHMENT_RETENTION_DAYS=30
# Dotted scanner implementation path, for example package.module.ScannerClass.
ATTACHMENT_SCANNER=

# Server-side speech-to-text for voice proposals (server-only).
# local_whisper uses an already-installed whisper-cli and an existing model;
# it never downloads weights. This is the pre-downloaded model on this machine.
# Production can use STT_PROVIDER=whisper with an OpenAI-compatible API key.
STT_PROVIDER=local_whisper
STT_MODEL=whisper-1
STT_API_BASE=
STT_API_KEY=
STT_TIMEOUT_SECONDS=60
STT_FAKE_TRANSCRIPT=
STT_LOCAL_BINARY=whisper-cli
STT_LOCAL_MODEL_PATH=~/Library/ggml-base.bin
STT_LOCAL_FFMPEG=ffmpeg
STT_LOCAL_THREADS=4
STT_LOCAL_TIMEOUT_SECONDS=180

# Gmail receipts integration (server-only OAuth credentials).
GMAIL_ENABLED=false
GMAIL_AI_EXTRACTION=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/gmail/callback/
GMAIL_WEB_REDIRECT_URL=http://127.0.0.1:4173/settings
GMAIL_TOKEN_ENCRYPTION_KEY=

# Public client configuration.
DUKAAN_API_BASE_URL=http://10.0.2.2:8000/api/v1
VITE_API_URL=http://127.0.0.1:8000

# Optional server-side observability.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

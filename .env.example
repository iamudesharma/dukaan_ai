# DukaanAI local development defaults. Copy to .env and keep that file private.
# These credentials are intentionally local-only and match compose.yaml.
DJANGO_SECRET_KEY=unsafe-local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_HOST=false
DATABASE_URL=postgresql://dukaan:dukaan_local_only@localhost:5433/dukaan
# Local least-privilege role for the API/worker (migrations use the owner above).
DUKAAN_APP_DB_ROLE=dukaan_app
DUKAAN_APP_DB_PASSWORD=dukaan_app_local_only
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=false
DEV_AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Interpreter (ChatGPT unofficial API)
# Set to true to enable AI-based interpretation (requires revChatGPT or similar)
USE_AI_INTERPRETER=false
# Session token from chat.openai.com cookies (__Secure-next-auth.session-token)
CHATGPT_SESSION_TOKEN=
CHATGPT_SESSION_TIMEOUT=3600

# Public client configuration.
DUKAAN_API_BASE_URL=http://10.0.2.2:8000/api/v1
DUKAAN_DEMO_MODE=true
DUKAAN_DEV_USER_ID=
VITE_API_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true

# Optional server-side observability.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

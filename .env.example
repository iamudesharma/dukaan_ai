# DukaanAI local development defaults. Copy to .env and keep that file private.
# These credentials are intentionally local-only and match compose.yaml.
DJANGO_SECRET_KEY=unsafe-local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_HOST=false
DATABASE_URL=postgresql://dukaan:dukaan_local_only@localhost:5433/dukaan
# Local least-privilege role for the API/worker (migrations use the owner above).
DUKAAN_APP_DB_ROLE=dukaan_app
DUKAAN_APP_DB_PASSWORD=dukaan_app_local_only
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_TASK_ALWAYS_EAGER=false
DEV_AUTH_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Fill these from `supabase status` for a local Supabase stack or from a
# dedicated non-production Supabase project. Never put a service-role key in a
# browser or Flutter build.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Public client configuration.
DUKAAN_API_BASE_URL=http://10.0.2.2:8000/api/v1
DUKAAN_DEMO_MODE=true
DUKAAN_DEV_USER_ID=
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=true

# Optional server-side observability.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
